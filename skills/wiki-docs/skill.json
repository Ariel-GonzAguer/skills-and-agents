{
  "name": "wiki-docs",
  "description": "Genera documentación técnica avanzada, completa y detallada para proyectos de software en Markdown. Crea una wiki estructurada por dominios técnicos orientada al onboarding de desarrolladores nuevos y a la referencia del equipo actual.",
  "version": "2.1.0",
  "author": [
    "Ariel GonzAgüer"
  ],
  "tags": [
    "documentation",
    "wiki",
    "technical-writing",
    "project-docs",
    "onboarding",
    "advanced-docs"
  ],
  "triggers": [
    "documentar proyecto",
    "documentar el proyecto",
    "documentar este repo",
    "documentar este repositorio",
    "documentar el repositorio",
    "crear wiki",
    "generar documentación",
    "generar documentacion",
    "documentación técnica",
    "documentacion tecnica",
    "document this project",
    "document this repo",
    "create wiki",
    "generate documentation",
    "technical documentation",
    "onboarding docs",
    "documentar para nuevos devs",
    "crear documentación de onboarding",
    "wiki del proyecto"
  ],
  "category": "documentation",
  "complexity": "high",
